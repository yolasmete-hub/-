<?xml version="1.0" encoding="utf-8"?>
<extension type="template" client="site" method="upgrade">
    <name>solidarity</name>
    <version>1.0.0</version>
    <creationDate>2026-07</creationDate>
    <author>Mete Yolaş</author>
    <authorEmail>yolasmete@gmail.com</authorEmail>
    <copyright>(C) 2026 Mete Yolaş</copyright>
    <license>GNU General Public License version 2 or later</license>
    <description>TPL_SOLIDARITY_XML_DESCRIPTION</description>

    <files>
        <filename>templateDetails.xml</filename>
        <filename>index.php</filename>
        <filename>component.php</filename>
        <filename>error.php</filename>
        <filename>offline.php</filename>
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
        <folder>html</folder>
        <folder>language</folder>
    </files>

    <positions>
        <position>topbar</position>
        <position>menu</position>
        <position>search</position>
        <position>hero</position>
        <position>ticker</position>
        <position>breadcrumbs</position>
        <position>top-a</position>
        <position>top-b</position>
        <position>main-top</position>
        <position>sidebar</position>
        <position>main-bottom</position>
        <position>bottom-a</position>
        <position>bottom-b</position>
        <position>signup</position>
        <position>footer-a</position>
        <position>footer-b</position>
        <position>footer-c</position>
        <position>footer-d</position>
        <position>social</position>
        <position>copyright</position>
        <position>debug</position>
    </positions>

    <languages folder="language">
        <language tag="en-GB">en-GB/tpl_solidarity.ini</language>
        <language tag="en-GB">en-GB/tpl_solidarity.sys.ini</language>
        <language tag="tr-TR">tr-TR/tpl_solidarity.ini</language>
        <language tag="tr-TR">tr-TR/tpl_solidarity.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic" label="TPL_SOLIDARITY_FIELDSET_BASIC">
                <field
                    name="logoFile"
                    type="media"
                    label="TPL_SOLIDARITY_LOGO_LABEL"
                    description="TPL_SOLIDARITY_LOGO_DESC"
                />
                <field
                    name="siteTitle"
                    type="text"
                    label="TPL_SOLIDARITY_SITE_TITLE_LABEL"
                    description="TPL_SOLIDARITY_SITE_TITLE_DESC"
                    filter="string"
                />
                <field
                    name="siteTagline"
                    type="text"
                    label="TPL_SOLIDARITY_TAGLINE_LABEL"
                    description="TPL_SOLIDARITY_TAGLINE_DESC"
                    filter="string"
                />
                <field
                    name="donateUrl"
                    type="url"
                    label="TPL_SOLIDARITY_DONATE_URL_LABEL"
                    description="TPL_SOLIDARITY_DONATE_URL_DESC"
                    filter="url"
                    validate="url"
                />
                <field
                    name="donateLabel"
                    type="text"
                    label="TPL_SOLIDARITY_DONATE_LABEL_LABEL"
                    description="TPL_SOLIDARITY_DONATE_LABEL_DESC"
                    default="TPL_SOLIDARITY_DONATE_LABEL_DEFAULT"
                    filter="string"
                />
            </fieldset>
            <fieldset name="advanced" label="TPL_SOLIDARITY_FIELDSET_ADVANCED">
                <field
                    name="stickyHeader"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="TPL_SOLIDARITY_STICKY_HEADER_LABEL"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="googleFonts"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="TPL_SOLIDARITY_GOOGLE_FONTS_LABEL"
                    description="TPL_SOLIDARITY_GOOGLE_FONTS_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="backToTop"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="TPL_SOLIDARITY_BACK_TO_TOP_LABEL"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="footerText"
                    type="textarea"
                    label="TPL_SOLIDARITY_FOOTER_TEXT_LABEL"
                    description="TPL_SOLIDARITY_FOOTER_TEXT_DESC"
                    rows="3"
                    filter="safehtml"
                />
            </fieldset>
        </fields>
    </config>
</extension>
